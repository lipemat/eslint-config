{
  "name": "@lipemat/eslint-config",
  "version": "5.3.0",
  "license": "MIT",
  "description": "Eslint configuration for all @lipemat packages",
  "engines": {
    "node": ">=22.21.1"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "helpers",
    "plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lipemat/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/lipemat/eslint-config/issues"
  },
  "homepage": "https://github.com/lipemat/eslint-config#readme",
  "scripts": {
    "build": "tsc --project ./plugins",
    "prepublishOnly": "yarn run build",
    "test": "jest",
    "validate-ts": "tsc --project ./plugins --noEmit",
    "watch": "tsc --project ./plugins --watch"
  },
  "dependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.3.3",
    "@lipemat/js-boilerplate-shared": "^1.1.1",
    "@stylistic/eslint-plugin-ts": "^2.12.1",
    "@types/eslint": "^9",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@wordpress/eslint-plugin": "25.7.0",
    "eslint": "^9",
    "eslint-plugin-deprecation": "^3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.13.0"
  },
  "devDependencies": {
    "@lipemat/js-boilerplate-svelte": "^3.3.0",
    "@types/jest": "^30",
    "@types/jquery": "^3.5.16",
    "@types/node": "^20",
    "@typescript-eslint/rule-tester": "^8.40.0",
    "@wordpress/i18n": "^6.24.0",
    "dompurify": "3.4.11",
    "execa": "^5.1.1",
    "jest": "^30.2.0",
    "jest-runner-eslint": "^2.2.1",
    "svelte": "^5.53.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.40.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@lipemat/eslint-config": "portal:."
  },
  "packageManager": "yarn@4.17.1"
}
